<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layout_marginTop="?attr/actionBarSize"
    tools:context=".RfidSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textAyudaRFID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/teal_700"
            android:padding="10dp"
            android:text="Configurar RFID traductor tag"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Input Principal: Tag RFID -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRfidTag"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tag RFID (24 caracteres HEX)"
            app:counterEnabled="true"
            app:counterMaxLength="24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRfidTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapCharacters"
                android:maxLines="4"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contenedor para los 12 pares de bytes -->
        <GridLayout
            android:id="@+id/glBytesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alignmentMode="alignBounds"
            android:columnCount="6"
            android:minHeight="50dp"
            android:rowCount="2">

            <!-- Los 12 TextViews se generarán o colocarán aquí.
                 Para mantener el código XML limpio, los podemos inflar dinámicamente en Kotlin
                 o declararlos uno a uno con IDs del tvByte0 al tvByte11 -->
        </GridLayout>

        <!-- Spinner 1: Byte Offset -->
        <TextView
            android:id="@+id/lblOffset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Byte Offset" />

        <Spinner
            android:id="@+id/spByteOffset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- Spinner 2: Bytes Reader -->
        <TextView
            android:id="@+id/lblBytesReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bytes to Read"/>

        <Spinner
            android:id="@+id/spBytesReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"/>

        <!-- Spinner 3: Formato -->
        <TextView
            android:id="@+id/lblFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Formato de Salida"/>

        <Spinner
            android:id="@+id/spFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- Resultado Traducido -->
        <!--        <CardView-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_marginTop="24dp"-->
        <!--            app:cardCornerRadius="8dp"-->
        <!--            app:cardElevation="4dp"-->
        <!--            app:layout_constraintTop_toBottomOf="@id/spFormat">-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dato Traducido:"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTranslatedResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="-"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarConfRfid"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancelar" />

            <Button
                android:id="@+id/btnGuardarConfRfid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guardar" />
        </LinearLayout>
        <!--        </CardView>-->

    </LinearLayout>
</ScrollView>